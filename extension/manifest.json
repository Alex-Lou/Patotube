{
  "manifest_version": 3,
  "name": "Patotube — Send to desktop",
  "short_name": "Patotube",
  "description": "Send the current YouTube / SoundCloud / Bandcamp / Audiomack / Internet Archive page to the Patotube desktop app.",
  "version": "0.5.0",
  "author": "Patotube",
  "homepage_url": "https://alex-lou.github.io/Patotube/",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Patotube",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "patotube@alex-lou.github.io",
      "strict_min_version": "109.0"
    }
  }
}
