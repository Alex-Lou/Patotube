<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Storage: lets Patotube write into /sdcard/Download/Patotube/
         on Android <= 12 with the legacy storage flag below. On
         Android 13+ scoped storage means we silently fall back to
         the app-external dir (still writable, still visible). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Keeps the CPU + WebView audio session alive when the user
         backgrounds the app while a track / video is playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service for media playback. The service displays
         a persistent "Lecture en cours" notification while a <video>
         or <audio> is playing, which is what tells Android to keep
         the WebView alive when the screen turns off or the app is
         backgrounded. POST_NOTIFICATIONS is needed on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.patotube"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- PATOTUBE share-target: appear in another app's
                 share sheet when it sends plain text. MainActivity
                 captures the URL from EXTRA_TEXT and forwards it
                 to React via the PatoMobile bridge. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- PATOTUBE open-with: appear in the system chooser
                 for audio + video files. MainActivity resolves the
                 content:// URI back to a real path and forwards
                 it to React for the embedded mini-player. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- PATOTUBE deep-link: catch `patotube://download?…`
                 / `patotube://open-file?…` on Android too, so a
                 userscript / extension running in a mobile browser
                 (or a tap on a `patotube://` link from anywhere on
                 the OS) can hand off to us. The Tauri deep-link
                 plugin only registers schemes on desktop; on
                 Android we declare the intent-filter manually. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="patotube" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->

            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- See MediaPlaybackService.kt for the why. -->
        <service
            android:name=".MediaPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>
</manifest>
